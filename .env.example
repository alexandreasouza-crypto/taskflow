# ===================================================
# TASKFLOW - VARIÁVEIS DE AMBIENTE (VERCEL & LOCAL)
# ===================================================

# [BACKEND]
# Chave secreta para assinatura dos tokens JWT (Obrigatória em produção)
JWT_SECRET=sua_chave_secreta_super_segura_jwt_2026

# Conexão com o Banco de Dados (Prisma)
# Local: "file:./dev.db" (SQLite)
# Produção (Vercel): URL do Postgres / Supabase / Neon / Turso
DATABASE_URL="file:./dev.db"

# Porta do servidor local (opcional, padrão 5000)
PORT=5000

# [FRONTEND]
# URL base da API (em produção na Vercel utilize '/api')
VITE_API_URL=/api
