{
  "name": "taskflow-server",
  "version": "1.0.0",
  "description": "Backend API for TaskFlow with Express, Prisma and SQLite",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
